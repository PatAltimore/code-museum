{
  "routes": [
    { "route": "/programs/*", "allowedRoles": ["anonymous"] },
    { "route": "/catalog.json", "allowedRoles": ["anonymous"] }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/css/*", "/js/*", "/programs/*", "/catalog.json", "/icon.*"]
  },
  "mimeTypes": { ".md": "text/plain" },
  "globalHeaders": {
    "Referrer-Policy": "no-referrer-when-downgrade"
  },
  "headers": [
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/js/*",
      "headers": { "Cache-Control": "no-cache" }
    },
    {
      "route": "/css/*",
      "headers": { "Cache-Control": "no-cache" }
    }
  ]
}
